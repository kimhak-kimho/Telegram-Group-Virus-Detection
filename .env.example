# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---------------------------------------------------------------
# Get this from @BotFather on Telegram (see README "Creating the bot").
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Optional ----------------------------------------------------------------
# Comma-separated Telegram user IDs who can always change /settings,
# regardless of their admin status in a given group. Leave empty if not needed.
SUPER_ADMIN_IDS=

# ClamAV daemon connection (matches the "clamav" service in docker-compose.yml)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60

# File size limits (megabytes). Per-group limits (set via /settings) cannot
# exceed HARD_MAX_FILE_SIZE_MB.
DEFAULT_MAX_FILE_SIZE_MB=50
HARD_MAX_FILE_SIZE_MB=200

# Where temporary downloads are written before scanning (auto-cleaned).
TEMP_DIR=/tmp/telegram_virus_bot

# SQLite database path (scan logs + settings — never file contents).
DB_PATH=data/bot.db
